{
    "name": "juanchosl/library",
    "description": "Abstraction for some crypt and password hashing in order to unify the creation and validation implementing interfaces",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/JuanchoSL/Password-Hashing",
    "keywords": [
        "security",
        "password",
        "crypt",
        "hash",
        "apr",
        "md5",
        "sha",
        "hashing"
    ],
    "authors": [
        {
            "name": "Juan Sánchez Lecegui",
            "email": "Juan.Sanchez@tecnicosweb.com",
            "homepage": "https://www.linkedin.com/in/juansanchezlecegui/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "juanchosl/datamanipulation": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "9.6.*",
        "phpstan/phpstan": "1.12.*"
    },
    "autoload": {
        "psr-4": {
            "JuanchoSL\\PasswordHashing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JuanchoSL\\PasswordHashing\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "tests": "vendor/bin/phpunit --configuration phpunit.xml tests",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon"
    }
}